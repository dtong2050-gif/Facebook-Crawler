# Facebook Credentials
# Sao chép file này thành .env và điền thông tin thật
FB_EMAIL=your-email@example.com
FB_PASSWORD=your-password-here

# Optional: Cookie trực tiếp từ browser (DevTools > Application > Cookies > facebook.com)
# Dùng khi không muốn điền email/password, hoặc khi có 2FA
FB_COOKIE_C_USER=
FB_COOKIE_XS=
FB_COOKIE_DATR=
